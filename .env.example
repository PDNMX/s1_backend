PORT=3101
# LOG_DIR=/ruta/a/logs   # por defecto: <repo>/logs (gitignorado)
# LOG_KEEP_DAYS=30       # borra app.log.yyyy-MM-dd.gz con más de N días; sin definir: conserva todo
# ALLOWED_HOSTS=s1.example.gob.mx    # cabeceras Host permitidas (coma-separadas); sin definir: todas
# ALLOWED_IPS=10.0.0.5,front01       # IPs/hostnames de cliente permitidos; sin definir: todos
# ALLOWED_ORIGINS=https://front.example.gob.mx  # orígenes CORS permitidos; sin definir: todos
